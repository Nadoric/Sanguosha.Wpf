<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

        <!-- SHAN HE YI / 墨漆鎏金：shared visual tokens, no game-state dependencies. -->
        <SolidColorBrush x:Key="SceneInk" Color="#10141E" />
        <SolidColorBrush x:Key="Cinnabar" Color="#9E4144" />
        <SolidColorBrush x:Key="TextPrimary" Color="#EDE6D8" />
        <SolidColorBrush x:Key="TextSecondary" Color="#B7B0A1" />
        <LinearGradientBrush x:Key="JadePanel" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FA252832" Offset="0" />
            <GradientStop Color="#F51A1D27" Offset="0.48" />
            <GradientStop Color="#FC111722" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BronzeEdge" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EED7A7" Offset="0" />
            <GradientStop Color="#71604C" Offset="0.45" />
            <GradientStop Color="#B9955E" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GoldSurface" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#ECD3A0" Offset="0" />
            <GradientStop Color="#C59A5C" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="QuietSurface" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3D3540" Offset="0" />
            <GradientStop Color="#242630" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="KeyboardFocus">
            <Setter Property="Control.Template">
                <Setter.Value><ControlTemplate>
                    <Border BorderBrush="#F4D79C" BorderThickness="1" CornerRadius="7" Margin="-3" />
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelSurface" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource JadePanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource BronzeEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="InsetSurface" TargetType="Border">
            <Setter Property="Background" Value="#9C111822" />
            <Setter Property="BorderBrush" Value="#635F5346" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D8BE8F" />
            <Setter Property="FontFamily" Value="KaiTi, STKaiti, SimSun" />
            <Setter Property="FontSize" Value="19" />
        </Style>

        <SolidColorBrush x:Key="Gold" Color="#DCC08A" />
        <SolidColorBrush x:Key="Muted" Color="#AFA89A" />
        <SolidColorBrush x:Key="Ink" Color="#171A22" />
        <SolidColorBrush x:Key="Line" Color="#665644" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EDE6D8" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E7DDCB" />
            <Setter Property="Background" Value="#282630" />
            <Setter Property="BorderBrush" Value="#786048" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#F2D49A" />
                                <Setter TargetName="Surface" Property="Background" Value="#453B39" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#FFF0BE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#D9B777" />
            <Setter Property="Foreground" Value="#231A17" />
            <Setter Property="BorderBrush" Value="#F2D9A7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFF1D1" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#C8BCA7" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckSurface" Width="16" Height="16" CornerRadius="3"
                                    BorderBrush="#A88E58" BorderThickness="1" Background="#191F29"
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                <Path x:Name="CheckMark" Data="M 3,7 L 6,10 L 12,3" Stroke="#FFE7B4"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckSurface" Property="Background" Value="#8E6D43" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="#F4DAA0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Margin="1,0">
                            <Track x:Name="PART_Track" Orientation="Horizontal"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                            <Border Height="3" Background="#C1A570" CornerRadius="1" />
                                        </ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12" Cursor="Hand">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb">
                                            <Border Background="#E9D1A0" BorderBrush="#816E4C"
                                                    BorderThickness="1" CornerRadius="6" />
                                        </ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                            <Border Height="3" Background="#3A3E48" CornerRadius="1" />
                                        </ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1B1D26" />
            <Setter Property="Foreground" Value="#ECE4CE" />
            <Setter Property="BorderBrush" Value="#786048" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="MaxWidth" Value="320" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#ECE4CE" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="PanningMode" Value="Both" />
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="#131720" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7">
                            <Track x:Name="PART_Track" IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand"
                                                  Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#887151" CornerRadius="7" Margin="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand"
                                                  Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="8" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand" />
                                <Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
            <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C5BEAF" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceBorder" BorderBrush="#6A573C" BorderThickness="1"
                                CornerRadius="7" Padding="16,9" Background="#222632">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="#C8AD76" />
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="#554237" />
                                <Setter Property="Foreground" Value="#F0D7A0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="#FFF0BE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ChoiceBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="#C8AD76" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Retain the legacy resource keys used by the view, replacing bitmap buttons with crisp vectors. -->
        <Style x:Key="OfficialAction" TargetType="Button" BasedOn="{StaticResource GoldButton}">
            <Setter Property="Background" Value="{StaticResource GoldSurface}" />
            <Setter Property="FontFamily" Value="KaiTi, STKaiti, SimSun" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Padding" Value="14,6" />
        </Style>
        <Style x:Key="OfficialCancel" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource QuietSurface}" />
            <Setter Property="Foreground" Value="#E1C99F" />
            <Setter Property="BorderBrush" Value="#8F7351" />
            <Setter Property="FontFamily" Value="KaiTi, STKaiti, SimSun" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Padding" Value="14,6" />
        </Style>
</ResourceDictionary>
